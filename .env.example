# WireGuard Dashboard 配置文件
# 复制为 .env 后修改：cp .env.example .env

# Web UI 密码（不设则使用默认值，不建议）
UI_PASSWORD=changeme

# Web UI 端口
UI_PORT=4623

# WireGuard 配置目录
CONFIG_DIR=/usr/local/etc/wireguard

# 日志目录
LOG_DIR=/var/log/wireguard

# 接口列表（空格分隔），如 "wg0 wg1"
INTERFACES=wg0

# 健康检查间隔（秒）
HEALTHCHECK_INTERVAL=60

# 日志轮转：超过此大小（字节）自动截断到最近 500 行
LOG_MAX_SIZE=10485760

# macOS 特定
# Homebrew 安装路径（M1/M2/M3 通常为 /opt/homebrew，Intel 为 /usr/local）
HOMEBREW_PREFIX=/opt/homebrew
